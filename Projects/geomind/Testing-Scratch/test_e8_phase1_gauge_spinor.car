// Projects/geomind/Testing-Scratch/test_e8_phase1_gauge_spinor.car
// Empirical Verification Suite for Phase 1 of CARTAN-E8 (GeoMind v2):
// [1.1] 120-D so(16) Gauge (+) 128-D S_16^+ Spinor Cross-Gating & Octonionic Fano Algebra
// [1.2] Asymmetric Finsler-Randers Directional Drift (||tilde{beta}|| < 1, F(x,v) != F(x,-v))

include "src/std/geom.cl";
include "Projects/geomind/geometry.cl";
include "Projects/geomind/streams.cl";
include "Projects/geomind/byte_latent.cl";

fn main() -> int {
    printf("=== CARTAN-E8 PHASE 1 VERIFICATION SUITE ===\n");
    cartan_flush(0.0);

    // 1. Verify all 240 E8 roots have squared norm == 2.0 and match std/geom.cl
    let num_roots = geomind_init_e8_roots_if_needed();
    printf("[Debug] geomind_init_e8_roots_if_needed returned %.1f\n", num_roots);
    cartan_flush(0.0);
    var bad_norms = 0.0;
    var bad_coords = 0.0;
    var r = 0.0;
    var nsq = 0.0;
    var d = 0.0;
    var c1 = 0.0;
    var c2 = 0.0;
    while (r < 240.0) {
        nsq = geomind_e8_root_norm_sq(r);
        if (math_abs_val(nsq - 2.0) > 0.0001) {
            bad_norms = bad_norms + 1.0;
        }
        d = 0.0;
        while (d < 8.0) {
            c1 = geomind_e8_get_root_coord(r, d);
            c2 = geom_e8_root_coordinate(r, d);
            if (math_abs_val(c1 - c2) > 0.0001) {
                bad_coords = bad_coords + 1.0;
            }
            d = d + 1.0;
        }
        r = r + 1.0;
    }
    printf("[Test 1.1a] 240 E8 Roots (112 Integer + 128 Spinor): total=%.1f, bad_norms=%.1f, coord_mismatch=%.1f\n", num_roots, bad_norms, bad_coords);
    cartan_flush(0.0);
    if (num_roots != 240.0 || bad_norms > 0.0 || bad_coords > 0.0) {
        printf("FAIL: E8 Root System verification failed.\n");
        return 1;
    }

    // 2. Verify Octonion Fano Plane Composition Norm Identity ||a * b|| = ||a|| * ||b||
    let oct_a = cartan_vec_create();
    let oct_b = cartan_vec_create();
    let oct_c = cartan_vec_create();
    var k = 0.0;
    var norm_a_sq = 0.0;
    var norm_b_sq = 0.0;
    var va = 0.0;
    var vb = 0.0;
    var vc = 0.0;
    while (k < 8.0) {
        va = 0.3 * (k + 1.0);
        vb = 0.2 * (8.0 - k) - 0.5;
        cartan_vec_push_f32(oct_a, va);
        cartan_vec_push_f32(oct_b, vb);
        cartan_vec_push_f32(oct_c, 0.0);
        norm_a_sq = norm_a_sq + va * va;
        norm_b_sq = norm_b_sq + vb * vb;
        k = k + 1.0;
    }
    geom_octonion_mul_raw8(oct_a, 0.0, oct_b, 0.0, oct_c, 0.0);
    var norm_c_sq = 0.0;
    k = 0.0;
    while (k < 8.0) {
        vc = cartan_vec_get_f32(oct_c, k);
        norm_c_sq = norm_c_sq + vc * vc;
        k = k + 1.0;
    }
    let expected_norm = sqrt(norm_a_sq * norm_b_sq);
    let actual_norm = sqrt(norm_c_sq);
    let oct_err = math_abs_val(actual_norm - expected_norm);
    printf("[Test 1.1b] Octonion Fano Composition Norm: ||a||*||b||=%.6f, ||a*b||=%.6f, err=%.8f\n", expected_norm, actual_norm, oct_err);
    cartan_flush(0.0);
    if (oct_err > 0.001) {
        printf("FAIL: Octonion norm identity violated.\n");
        return 1;
    }

    // 3. Verify 120-D (+) 128-D E8 Gauge-on-Spinor Cross-Gating & S^247 Norm Conservation
    let v_in_248 = cartan_vec_create();
    let v_out_248 = cartan_vec_create();
    d = 0.0;
    var in_norm_sq = 0.0;
    var val = 0.0;
    while (d < 248.0) {
        val = sin((d + 1.0) * 0.13) + 0.5 * cos((d + 1.0) * 0.07);
        cartan_vec_push_f32(v_in_248, val);
        cartan_vec_push_f32(v_out_248, 0.0);
        in_norm_sq = in_norm_sq + val * val;
        d = d + 1.0;
    }
    geomind_e8_gauge_spinor_cross_gate(v_in_248, v_out_248, 0.30);

    var out_norm_sq = 0.0;
    var gauge_delta_sq = 0.0;
    var spinor_delta_sq = 0.0;
    var vi = 0.0;
    var vo = 0.0;
    var diff = 0.0;
    d = 0.0;
    while (d < 248.0) {
        vi = cartan_vec_get_f32(v_in_248, d);
        vo = cartan_vec_get_f32(v_out_248, d);
        out_norm_sq = out_norm_sq + vo * vo;
        diff = vo - vi;
        if (d < 120.0) {
            gauge_delta_sq = gauge_delta_sq + diff * diff;
        } else {
            spinor_delta_sq = spinor_delta_sq + diff * diff;
        }
        d = d + 1.0;
    }
    let norm_in = sqrt(in_norm_sq);
    let norm_out = sqrt(out_norm_sq);
    let norm_diff = math_abs_val(norm_in - norm_out);
    let gauge_delta = sqrt(gauge_delta_sq);
    let spinor_delta = sqrt(spinor_delta_sq);
    printf("[Test 1.1c] 248-D Gauge-Spinor Cross-Gate: ||in||=%.6f, ||out||=%.6f, norm_err=%.8f, gauge_delta=%.6f, spinor_delta=%.6f\n", norm_in, norm_out, norm_diff, gauge_delta, spinor_delta);
    cartan_flush(0.0);
    if (norm_diff > 0.001 || gauge_delta < 0.01 || spinor_delta < 0.01) {
        printf("FAIL: Gauge-Spinor cross-gating failed norm conservation or sector excitation.\n");
        return 1;
    }

    // 4. Verify Asymmetric Finsler-Randers Directional Drift (F(x, v) != F(x, -v) and ||tilde{beta}|| < 1)
    let v_pos = cartan_vec_create();
    let v_neg = cartan_vec_create();
    let drift_b = cartan_vec_create();
    let bounded_b = cartan_vec_create();
    var vv = 0.0;
    var bb = 0.0;
    d = 0.0;
    while (d < 248.0) {
        vv = 0.4 * cos(d * 0.11) + 0.2;
        bb = 2.5 * cos(d * 0.11) + 1.0;
        cartan_vec_push_f32(v_pos, vv);
        cartan_vec_push_f32(v_neg, 0.0 - vv);
        cartan_vec_push_f32(drift_b, bb);
        cartan_vec_push_f32(bounded_b, 0.0);
        d = d + 1.0;
    }
    var null_metric: ptr = 0.0;
    let bounded_norm = geom_finsler_randers_bound_drift(drift_b, null_metric, 248.0, bounded_b);
    let f_forward = geom_finsler_randers_tangent_norm(v_pos, drift_b, null_metric, 248.0);
    let f_reverse = geom_finsler_randers_tangent_norm(v_neg, drift_b, null_metric, 248.0);
    let frs_ab = geomind_frs_brainstem_distance(v_neg, v_pos, v_pos, v_pos, drift_b, 248.0);
    let frs_ba = geomind_frs_brainstem_distance(v_pos, v_pos, v_neg, v_pos, drift_b, 248.0);
    let asym_diff = math_abs_val(f_forward - f_reverse);
    let frs_asym = math_abs_val(frs_ab - frs_ba);
    printf("[Test 1.2] Finsler-Randers Convexity & Asymmetry: ||tilde_beta||=%.6f (< 1.0), F(+v)=%.6f, F(-v)=%.6f, |F(+v)-F(-v)|=%.6f, |FRS(A->B)-FRS(B->A)|=%.6f\n", bounded_norm, f_forward, f_reverse, asym_diff, frs_asym);
    if (bounded_norm >= 1.0 || f_forward <= 0.0 || f_reverse <= 0.0 || asym_diff < 0.1 || frs_asym < 0.1) {
        printf("FAIL: Finsler-Randers convexity or causal asymmetry check failed.\n");
        return 1;
    }

    // 4.5. Test Adjoint Octonion Conjugate Multiplication & 120 (+) 128 Cross-Gate Backward Jacobian
    let dc_oct = cartan_vec_create();
    let da_oct = cartan_vec_create();
    let db_oct = cartan_vec_create();
    k = 0.0;
    while (k < 8.0) {
        cartan_vec_push_f32(dc_oct, 0.25 * cos(k + 0.5));
        cartan_vec_push_f32(da_oct, 0.0);
        cartan_vec_push_f32(db_oct, 0.0);
        k = k + 1.0;
    }
    geom_octonion_mul_backward_raw8(oct_a, 0.0, oct_b, 0.0, dc_oct, 0.0, da_oct, 0.0, db_oct, 0.0);
    var dot_c_dc = 0.0;
    var dot_a_da = 0.0;
    var dot_b_db = 0.0;
    k = 0.0;
    while (k < 8.0) {
        dot_c_dc = dot_c_dc + cartan_vec_get_f32(oct_c, k) * cartan_vec_get_f32(dc_oct, k);
        dot_a_da = dot_a_da + cartan_vec_get_f32(oct_a, k) * cartan_vec_get_f32(da_oct, k);
        dot_b_db = dot_b_db + cartan_vec_get_f32(oct_b, k) * cartan_vec_get_f32(db_oct, k);
        k = k + 1.0;
    }
    let adj_err_a = math_abs_val(dot_c_dc - dot_a_da);
    let adj_err_b = math_abs_val(dot_c_dc - dot_b_db);
    let dh_in_248 = cartan_vec_create();
    let dh_out_248 = cartan_vec_create();
    d = 0.0;
    while (d < 248.0) {
        cartan_vec_push_f32(dh_in_248, 0.1 * sin(d * 0.13 + 0.4));
        cartan_vec_push_f32(dh_out_248, 0.0);
        d = d + 1.0;
    }
    geomind_e8_gauge_spinor_cross_gate_backward(v_in_248, dh_in_248, dh_out_248, 0.25);
    var dh_gauge_norm = 0.0;
    var dh_spinor_norm = 0.0;
    d = 0.0;
    while (d < 248.0) {
        let dv = cartan_vec_get_f32(dh_out_248, d);
        if (d < 120.0) { dh_gauge_norm = dh_gauge_norm + dv * dv; }
        else { dh_spinor_norm = dh_spinor_norm + dv * dv; }
        d = d + 1.0;
    }
    dh_gauge_norm = sqrt(dh_gauge_norm);
    dh_spinor_norm = sqrt(dh_spinor_norm);
    printf("[Test 1.3] Adjoint Octonion & Cross-Gate Backward: |<a*b,dc>-<a,da>|=%.9f, |<a*b,dc>-<b,db>|=%.9f, ||dGauge||=%.6f, ||dSpinor||=%.6f\n", adj_err_a, adj_err_b, dh_gauge_norm, dh_spinor_norm);
    if (adj_err_a > 0.00001 || adj_err_b > 0.00001 || dh_gauge_norm <= 0.0 || dh_spinor_norm <= 0.0) {
        printf("FAIL: Adjoint Octonion identity or Cross-Gate Backward Jacobian failed.\n");
        return 1;
    }

    printf("=== ALL PHASE 1 (120-D (+) 128-D GAUGE-SPINOR & FINSLER-RANDERS) TESTS PASSED ===\n\n");
    cartan_flush(0.0);

    // 5. Phase 2: Markov-Lagrangian Principle of Least Action (10 epochs on Russell/Cartan passage)
    printf("=== CARTAN-E8 PHASE 2 & 3 VERIFICATION SUITE ===\n");
    cartan_flush(0.0);
    geomind_visualizer_reset();
    let sample_corpus = "In pure mathematics and differential geometry, the exceptional Lie algebra E8 decomposes into the 120-dimensional orthogonal gauge algebra so(16) and the 128-dimensional Majorana-Weyl spinor representation S16+. Geodesic trajectories minimize the Markov-Lagrangian Action along the Finsler-Randers manifold.";
    let act_ep1 = geomind_byte_latent_train_corpus(sample_corpus, 1.0, 0.04, 1.0);
    let act_ep10 = geomind_byte_latent_train_corpus(sample_corpus, 9.0, 0.04, 1.0);
    let p_th = geomind_markov_get_prob(116.0, 104.0); // 't' -> 'h'
    let coast_flag = geomind_should_geodesic_coast(116.0, 104.0, 0.02, 0.10);
    let markov_ckpt_ok = cartan_file_exists("Projects/geomind/trainingdata/checkpoints/geomind_markov_prior.bin");
    let blat_ckpt_ok = cartan_file_exists("Projects/geomind/trainingdata/checkpoints/geomind_byte_latent_e8.bin");
    printf("[Test 2.1-2.4] Markov-Lagrangian Action Relaxation: S(ep1)=%.6f -> S(ep10)=%.6f, P('h'|'t')=%.4f, coast_gate=%.1f, ckpts=(%.0f, %.0f)\n", act_ep1, act_ep10, p_th, coast_flag, markov_ckpt_ok, blat_ckpt_ok);
    cartan_flush(0.0);
    if (act_ep10 >= act_ep1 || coast_flag != 1.0 || markov_ckpt_ok != 1.0 || blat_ckpt_ok != 1.0) {
        printf("FAIL: Lagrangian Action did not decrease over 10 epochs, coast gate failed, or checkpoints missing.\n");
        return 1;
    }

    // 6. Phase 3: Tokenizer-Free Byte-Latent Dynamic Surprisal Patching & Autoregressive Generation
    let patches = geomind_byte_latent_encode_stream(sample_corpus, 3.2);
    let total_patch_floats = cartan_vec_len(patches);
    let num_patches = total_patch_floats / 248.0;
    let corpus_bytes = cartan_string_length(sample_corpus);
    let comp_ratio = num_patches / corpus_bytes;
    let gen_out = geomind_byte_latent_generate("In pure mathematics", 24.0);
    let coast_cnt = geomind_byte_latent_get_coast_count();
    printf("[Test 3.1-3.4] Byte-Latent Patching: bytes=%.0f, patches=%.0f (ratio=%.3f < 1.0), live_coasts=%.0f, Generated='%s'\n", corpus_bytes, num_patches, comp_ratio, coast_cnt, gen_out);
    cartan_flush(0.0);
    if (num_patches <= 0.0 || num_patches >= corpus_bytes || coast_cnt <= 0.0) {
        printf("FAIL: Dynamic byte-latent patching or live geodesic coasting failed.\n");
        return 1;
    }

    // 7. Phase 4: Domain-Bounded Web Crawler & Live Manifold Relaxation Visualizer (manifold_relaxation.html)
    printf("\n=== CARTAN-E8 PHASE 4 VERIFICATION SUITE ===\n");
    cartan_flush(0.0);
    let test_html_path = "scratch/test_e8_crawl_sample.html";
    let sample_html = "<html><head><title>E8 Manifold</title></head><body><h1>Cartan E8</h1><p>In pure mathematics and differential geometry, the exceptional Lie algebra E8 decomposes into so(16) and S16+.</p><a href=\"https://example.org/subpage\">Subpage</a></body></html>";
    cartan_write_file(test_html_path, sample_html);
    let crawl_act = geomind_crawl_and_train(test_html_path, "example.org", 0.0, 0.0, 1.0, 3.0, 1.0);
    let vis_exists = cartan_file_exists("manifold_relaxation.html");
    printf("[Test 4.1-4.3] Crawler & Visualizer: crawl_action=%.6f, manifold_relaxation.html exists=%.1f\n", crawl_act, vis_exists);
    cartan_flush(0.0);
    if (crawl_act <= 0.0 || vis_exists != 1.0) {
        printf("FAIL: Phase 4 crawler or visualizer export failed.\n");
        return 1;
    }

    // 8. Stage 2.2: 4x4 Freudenthal-Tits Magic Square Division-Algebra MoE (R, C, H, O Adjoint & S^247 Retraction)
    printf("\n=== CARTAN-E8 STAGE 1-3 DEEP NON-EUCLIDEAN STACK VERIFICATION SUITE ===\n");
    cartan_flush(0.0);
    let da_u = cartan_vec_create();
    let da_x = cartan_vec_create();
    let da_y = cartan_vec_create();
    let da_dy = cartan_vec_create();
    let da_dx = cartan_vec_create();
    let da_du = cartan_vec_create();
    var di = 0.0;
    while (di < 8.0) {
        cartan_vec_push_f32(da_u, 0.35 + 0.11 * di);
        cartan_vec_push_f32(da_x, -0.25 + 0.17 * di);
        cartan_vec_push_f32(da_y, 0.0);
        cartan_vec_push_f32(da_dy, 0.40 - 0.09 * di);
        cartan_vec_push_f32(da_dx, 0.0);
        cartan_vec_push_f32(da_du, 0.0);
        di = di + 1.0;
    }
    var max_alg_adj_err = 0.0;
    var alg_t = 0.0;
    while (alg_t < 4.0) {
        geomind_division_algebra_mul_raw8(alg_t, da_u, 0.0, da_x, 0.0, da_y, 0.0);
        geomind_division_algebra_mul_backward_raw8(alg_t, da_u, 0.0, da_x, 0.0, da_dy, 0.0, da_du, 0.0, da_dx, 0.0);
        var dot_y_dy = 0.0;
        var dot_x_dx = 0.0;
        di = 0.0;
        while (di < 8.0) {
            dot_y_dy = dot_y_dy + cartan_vec_get_f32(da_y, di) * cartan_vec_get_f32(da_dy, di);
            dot_x_dx = dot_x_dx + cartan_vec_get_f32(da_x, di) * cartan_vec_get_f32(da_dx, di);
            di = di + 1.0;
        }
        let err_alg = math_abs_val(dot_y_dy - dot_x_dx);
        if (err_alg > max_alg_adj_err) { max_alg_adj_err = err_alg; }
        alg_t = alg_t + 1.0;
    }
    let moe_out_248 = cartan_vec_create();
    let moe_dh_in_248 = cartan_vec_create();
    let moe_u_before = cartan_vec_create();
    di = 0.0;
    while (di < 256.0) {
        cartan_vec_push_f32(moe_u_before, 0.0);
        if (di < 248.0) {
            cartan_vec_push_f32(moe_out_248, 0.0);
            cartan_vec_push_f32(moe_dh_in_248, 0.0);
        }
        di = di + 1.0;
    }
    geomind_freudenthal_init_if_needed();
    di = 0.0;
    while (di < 256.0) {
        cartan_vec_set_f32(moe_u_before, di, cartan_vec_get_f32(g_freudenthal_expert_ops_256, di));
        di = di + 1.0;
    }
    geomind_freudenthal_moe_forward_248(v_in_248, dh_in_248, bounded_b, g_freudenthal_expert_ops_256, moe_out_248, 0.25);
    geomind_freudenthal_moe_backward_248(v_in_248, dh_in_248, bounded_b, g_freudenthal_expert_ops_256, dh_in_248, moe_dh_in_248, 0.25, 0.05);
    var moe_out_norm = 0.0;
    var moe_du_norm = 0.0;
    di = 0.0;
    while (di < 256.0) {
        let duv = cartan_vec_get_f32(g_freudenthal_expert_ops_256, di) - cartan_vec_get_f32(moe_u_before, di);
        moe_du_norm = moe_du_norm + duv * duv;
        if (di < 248.0) {
            let mov = cartan_vec_get_f32(moe_out_248, di);
            moe_out_norm = moe_out_norm + mov * mov;
        }
        di = di + 1.0;
    }
    moe_out_norm = sqrt(moe_out_norm);
    moe_du_norm = sqrt(moe_du_norm);
    let moe_norm_diff = math_abs_val(moe_out_norm - norm_in);
    let e8_cell_dim = geomind_freudenthal_lie_dim(3.0, 3.0);
    printf("[Test 5.1] Freudenthal 4x4 Magic Square MoE (R,C,H,O): dim(O(x)O)=%.0f, max_adj_err=%.9f, |norm_diff|=%.8f, ||dU_moe||=%.6f\n", e8_cell_dim, max_alg_adj_err, moe_norm_diff, moe_du_norm);
    cartan_flush(0.0);
    if (e8_cell_dim != 248.0 || max_alg_adj_err > 0.00001 || moe_norm_diff > 0.0001 || moe_du_norm <= 0.0) {
        printf("FAIL: Freudenthal Magic Square MoE division-algebra adjoint or S^247 norm preservation failed.\n");
        return 1;
    }

    // 9. Stage 2.1: Non-Euclidean Asymmetric Finsler-Randers Causal Attention (Forward & Backward)
    let seq_q = cartan_vec_create();
    let seq_k = cartan_vec_create();
    let seq_v = cartan_vec_create();
    let seq_out = cartan_vec_create();
    let d_seq_q = cartan_vec_create();
    let d_seq_k = cartan_vec_create();
    let d_seq_v = cartan_vec_create();
    let d_randers_b = cartan_vec_create();
    di = 0.0;
    while (di < 496.0) {
        let base_v = cartan_vec_get_f32(v_in_248, math_mod_val(di, 248.0));
        let shift = 0.15 * sin(di * 0.17);
        cartan_vec_push_f32(seq_q, base_v + shift);
        cartan_vec_push_f32(seq_k, base_v - shift);
        cartan_vec_push_f32(seq_v, base_v * 0.9 + 0.05 * cos(di * 0.13));
        cartan_vec_push_f32(seq_out, 0.0);
        cartan_vec_push_f32(d_seq_q, 0.0);
        cartan_vec_push_f32(d_seq_k, 0.0);
        cartan_vec_push_f32(d_seq_v, 0.0);
        if (di < 248.0) {
            cartan_vec_push_f32(d_randers_b, 0.0);
        }
        di = di + 1.0;
    }
    let avg_fr_dist = e8_finsler_randers_causal_attention_forward_248(seq_q, seq_k, seq_v, 2.0, bounded_b, seq_out, 0.25);
    e8_finsler_randers_causal_attention_backward_248(seq_q, seq_k, seq_v, seq_out, 2.0, bounded_b, 0.25, d_seq_q, d_seq_k, d_seq_v, d_randers_b);
    var dq_norm = 0.0;
    var db_norm = 0.0;
    di = 0.0;
    while (di < 248.0) {
        let dqv = cartan_vec_get_f32(d_seq_q, 248.0 + di);
        let dbv = cartan_vec_get_f32(d_randers_b, di);
        dq_norm = dq_norm + dqv * dqv;
        db_norm = db_norm + dbv * dbv;
        di = di + 1.0;
    }
    dq_norm = sqrt(dq_norm);
    db_norm = sqrt(db_norm);
    printf("[Test 5.2] Finsler-Randers Causal Attention (8x31-D): avg_d_FR=%.6f, ||dQ||=%.6f, ||dBeta||=%.6f\n", avg_fr_dist, dq_norm, db_norm);
    cartan_flush(0.0);
    if (avg_fr_dist <= 0.0 || dq_norm <= 0.0 || db_norm <= 0.0) {
        printf("FAIL: Non-Euclidean Finsler-Randers Causal Attention forward or backward failed.\n");
        return 1;
    }

    // 10. Stage 1 & 3: Deep Multi-Layer E8 Gauge-Spinor Manifold Stack Training, Generation & Persistence
    let deep_corpus = "Cartan E8 gauge-spinor geometry unifies the 120-D so(16) adjoint gauge algebra with the 128-D S16+ Majorana-Weyl spinor representation.";
    let deep_act_ep1 = geomind_byte_latent_train_deep_e8_corpus(deep_corpus, 4.0, 1.0, 0.04, 1.0);
    let deep_act_ep5 = geomind_byte_latent_train_deep_e8_corpus(deep_corpus, 4.0, 4.0, 0.04, 1.0);
    let deep_gen = geomind_byte_latent_generate_deep_e8("Cartan E8", 4.0, 16.0);
    let stack_ckpt_ok = cartan_file_exists("Projects/geomind/trainingdata/checkpoints/geomind_e8_deep_stack.bin");
    let stack_reload_ok = geomind_e8_stack_load("Projects/geomind/trainingdata/checkpoints/geomind_e8_deep_stack.bin");
    printf("[Test 5.3] Deep Multi-Layer E8 Stack (L=4): S(ep1)=%.6f -> S(ep5)=%.6f, ckpt=(%.0f, reload=%.0f), Gen='%s'\n", deep_act_ep1, deep_act_ep5, stack_ckpt_ok, stack_reload_ok, deep_gen);
    cartan_flush(0.0);
    if (deep_act_ep5 >= deep_act_ep1 || stack_ckpt_ok != 1.0 || stack_reload_ok != 1.0) {
        printf("FAIL: Deep Multi-Layer E8 Stack Action relaxation or checkpoint persistence failed.\n");
        return 1;
    }

    printf("\n=== ALL CARTAN-E8 (PHASES 1-4 & DEEP NON-EUCLIDEAN STACK STAGES 1-3) VERIFICATION TESTS PASSED 100%% ===\n");
    cartan_flush(0.0);
    return 0;
}
