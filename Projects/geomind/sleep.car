// Projects/geomind/sleep.car
// GeoMind Autonomous Metacognitive Sleep Consolidation Daemon (Continuous 248-D E8 Manifold)
// Standalone background daemon for offline memory consolidation, geodesic SLERP bridging,
// and synaptic homeostasis during system idle.

include "Projects/geomind/sleep.cl";

extern fn sys_get_arg_count() -> float;
extern fn sys_get_arg(idx: float) -> string;
extern fn atof(s: string) -> float;
extern fn cartan_string_eq(s1: string, s2: string) -> float;

fn main() -> float {
    let argc = sys_get_arg_count();
    var cycles = 1.0;
    var i = 1.0;
    while (i < argc) {
        let arg = sys_get_arg(i);
        if (cartan_string_eq(arg, "-cycles") == 1.0 || cartan_string_eq(arg, "--cycles") == 1.0) {
            if (i + 1.0 < argc) {
                cycles = atof(sys_get_arg(i + 1.0));
            }
        }
        i = i + 1.0;
    }

    if (cycles < 1.0) { cycles = 1.0; }
    geomind_sleep_run_full_cycle(cycles);
    return 0.0;
}
