extern fn sys_get_arg_count() -> float;
extern fn sys_get_arg(idx: float) -> string;
extern fn atof(s: string) -> float;
extern fn cartan_flush(v: float) -> float;
extern fn cartan_read_line() -> string;

fn print_help_dialogue() -> float {
    printf("================================================================================\n");
    printf("  GEOMIND SOVEREIGN AI ENGINE (geomind.exe)\n");
    printf("  Lie Group E8 Manifold Architecture | 42-Layer Octonionic Geodesic Stack\n");
    printf("  Continuous S^{247} Manifold | Tokenizer-Free Byte-Latent (BLT) Engine\n");
    printf("================================================================================\n\n");
    printf("Usage: geomind.exe [mode flag] [options]\n");
    printf("  (Default: Launches interactive 248-D E8 Chat REPL when run without mode flags)\n\n");
    printf("Modes:\n");
    printf("  --chat          Start interactive 248-D E8 continuous manifold chat REPL (DEFAULT MODE)\n");
    printf("                  Options: -prompt <text>, -layers <N>, -bytes <N>\n");
    printf("  --eval-qa       Run 20-Question Epistemic & Subtle Geometric Evaluation Suite (-layers <N>)\n");
    printf("  --curriculum    Run 4-Rung Concentric English Storytelling Curriculum (-layers <N>, -lr <float>)\n");
    printf("  --train-strata  Directly train all 6 strata of e8_stack.cl on relational concept transitions\n");
    printf("  --train-sft     Run Supervised Fine-Tuning with prompt loss masking on JSON manifest (-target <file>, -epochs <N>, -lr <float>)\n");
    printf("  --train-ce      Run Causal Pre-training (CE) over raw text corpus (-target <file>, -epochs <N>, -lr <float>)\n");
    printf("  --train-cloze   Run Cloze Concept Curriculum Training (-target <file>, -epochs <N>, -lr <float>)\n");
    printf("  --streams       Execute 8-Stream Lie Subgroup Cortical Processing Verification\n");
    printf("  --sleep         Run Autonomous Metacognitive Sleep Consolidation (-cycles <N>)\n");
    printf("  --ode-test      Execute TS^{247} Symplectic Geodesic ODE Integrator Verification\n");
    printf("  --azr           Execute Autonomous Active Zero-Shot Reasoner Self-Play (-episodes <N>, -lr <float>)\n");
    printf("  --webgpu-test   Verify WebGPU E8 Acceleration WGSL Compute Shader Pipeline\n");
    printf("  --merge-test    Verify E8 Lie Algebra Model Weight Merging (SLERP, TIES, DARE, Task Arithmetic)\n");
    printf("  --ising-test    Execute 248-Spin Ising Decision Glass & Simulated Annealing Verification\n");
    printf("  --log-test      Execute Non-Euclidean Telemetry Structured Logger Verification\n");
    printf("  --index-basins  Pre-index and serialize S^{247} sentence basins and relational operators\n");
    printf("  --byte-latent   Run 248-D E8 Tokenizer-Free Byte-Latent + Markov-Lagrangian Engine\n");
    printf("                  Options: -target <file>, -prompt <text>, -layers <N>, -epochs <N>, -lr <float>, --visualize\n");
    printf("  --crawl <url>   Run Autonomous Domain-Bounded Recursive Web Crawler (--recurse, --max-depth <N>, -epochs <N>)\n");
    printf("  --help, -h      Display this help dialogue and exit\n\n");
    printf("Training & Optimization Flags:\n");
    printf("  -target <file>       Explicit dataset file path on disk (Defaults to stage corpus)\n");
    printf("  -prompt <text>       Input text prompt or question for generation / evaluation\n");
    printf("  -epochs <num>, -ep   Maximum training epoch ceiling (Default: 5.0)\n");
    printf("  -layers <num>        Number of active E8 stack layers (Default: 42.0)\n");
    printf("  -lr <float>          Base learning rate ceiling (Default: 0.03)\n");
    printf("  --visualize          Export HTML SVG manifold visualization to manifold_relaxation.html\n\n");
    printf("================================================================================\n");
    cartan_flush(0.0);
    return 0.0;
}

// Check presence of CLI flag matching single or double dash
fn get_cli_flag_present(flag_name: string, arg_count: float) -> float {
    var i = 1.0;
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        if (cartan_string_eq(arg, flag_name) == 1.0) {
            return 1.0;
        }
        if (cartan_string_starts_with(flag_name, "-") == 1.0) {
            let dbl = cartan_string_concat("-", flag_name);
            if (cartan_string_eq(arg, dbl) == 1.0) {
                return 1.0;
            }
        }
        i = i + 1.0;
    }
    return 0.0;
}

// Retrieve string CLI parameter value matching single or double dash
fn get_cli_param(flag_name: string, arg_count: float) -> string {
    var i = 1.0;
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        var is_matched = 0.0;
        if (cartan_string_eq(arg, flag_name) == 1.0) {
            is_matched = 1.0;
        }
        if (is_matched == 0.0 && cartan_string_starts_with(flag_name, "-") == 1.0) {
            let dbl = cartan_string_concat("-", flag_name);
            if (cartan_string_eq(arg, dbl) == 1.0) {
                is_matched = 1.0;
            }
        }
        if (is_matched == 1.0 && (i + 1.0) < arg_count) {
            return sys_get_arg(i + 1.0);
        }
        i = i + 1.0;
    }
    return "";
}

// Retrieve float CLI parameter value with fallback default
fn get_cli_param_float(flag_name: string, arg_count: float, default_val: float) -> float {
    let p = get_cli_param(flag_name, arg_count);
    if (cartan_string_length(p) > 0.0) {
        return atof(p);
    }
    return default_val;
}

// Retrieve multi-word CLI prompt argument
fn get_cli_prompt(arg_count: float) -> string {
    var i = 1.0;
    while (i < arg_count) {
        let arg = sys_get_arg(i);
        if (cartan_string_eq(arg, "-prompt") == 1.0 || cartan_string_eq(arg, "--prompt") == 1.0 ||
            cartan_string_eq(arg, "-p") == 1.0 || cartan_string_eq(arg, "--p") == 1.0) {
            var full_prompt = "";
            var j = i + 1.0;
            while (j < arg_count) {
                let next_arg = sys_get_arg(j);
                if (cartan_string_starts_with(next_arg, "-") == 1.0) {
                    break;
                }
                if (cartan_string_length(full_prompt) > 0.0) {
                    full_prompt = cartan_string_concat(full_prompt, " ");
                }
                full_prompt = cartan_string_concat(full_prompt, next_arg);
                j = j + 1.0;
            }
            return full_prompt;
        }
        i = i + 1.0;
    }
    return "";
}

fn get_cli_target_path(arg_count: float) -> string {
    return get_cli_param("-target", arg_count);
}

fn get_cli_epochs(arg_count: float, default_val: float) -> float {
    let ep = get_cli_param("-epochs", arg_count);
    if (cartan_string_length(ep) > 0.0) {
        return atof(ep);
    }
    let ep_short = get_cli_param("-ep", arg_count);
    if (cartan_string_length(ep_short) > 0.0) {
        return atof(ep_short);
    }
    return default_val;
}

// Determines if a command line flag is an explicit non-chat command mode
fn is_explicit_non_chat_mode(flag: string) -> float {
    if (cartan_string_eq(flag, "--help") == 1.0 || cartan_string_eq(flag, "-h") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--curriculum") == 1.0 || cartan_string_eq(flag, "-curriculum") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--eval-qa") == 1.0 || cartan_string_eq(flag, "-eval-qa") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--index-basins") == 1.0 || cartan_string_eq(flag, "-index-basins") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--train-strata") == 1.0 || cartan_string_eq(flag, "-train-strata") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--train-sft") == 1.0 || cartan_string_eq(flag, "-train-sft") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--train-ce") == 1.0 || cartan_string_eq(flag, "-train-ce") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--train-cloze") == 1.0 || cartan_string_eq(flag, "-train-cloze") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--streams") == 1.0 || cartan_string_eq(flag, "-streams") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--sleep") == 1.0 || cartan_string_eq(flag, "-sleep") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--ode-test") == 1.0 || cartan_string_eq(flag, "-ode-test") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--azr") == 1.0 || cartan_string_eq(flag, "-azr") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--webgpu-test") == 1.0 || cartan_string_eq(flag, "-webgpu-test") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--merge-test") == 1.0 || cartan_string_eq(flag, "-merge-test") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--ising-test") == 1.0 || cartan_string_eq(flag, "-ising-test") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--log-test") == 1.0 || cartan_string_eq(flag, "-log-test") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--byte-latent") == 1.0 || cartan_string_eq(flag, "-byte-latent") == 1.0) { return 1.0; }
    if (cartan_string_eq(flag, "--crawl") == 1.0 || cartan_string_eq(flag, "-crawl") == 1.0) { return 1.0; }
    return 0.0;
}

fn main() -> float {
    let arg_count = sys_get_arg_count();
    if (get_cli_flag_present("--help", arg_count) > 0.0 || get_cli_flag_present("-h", arg_count) > 0.0) {
        print_help_dialogue();
        return 0.0;
    }

    printf("[CARTAN-E8 Mode] Sovereign 248D Non-Euclidean E8 Manifold Engine (Zero Pretrained Weights Mounted)\n");
    cartan_flush(0.0);

    // Scan for explicit command flags
    var i = 1.0;
    while (i < arg_count) {
        let flag = sys_get_arg(i);

        if (cartan_string_eq(flag, "--curriculum") == 1.0 || cartan_string_eq(flag, "-curriculum") == 1.0) {
            let layers = get_cli_param_float("-layers", arg_count, 42.0);
            let lr = get_cli_param_float("-lr", arg_count, 0.03);
            geomind_run_english_curriculum(layers, lr);
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--eval-qa") == 1.0 || cartan_string_eq(flag, "-eval-qa") == 1.0) {
            let layers = get_cli_param_float("-layers", arg_count, 42.0);
            geomind_run_epistemic_eval_suite(layers);
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--index-basins") == 1.0 || cartan_string_eq(flag, "-index-basins") == 1.0) {
            geomind_e8_populate_and_save_sentence_basins(g_curriculum_checkpoint_dir);
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--train-strata") == 1.0 || cartan_string_eq(flag, "-train-strata") == 1.0) {
            geomind_e8_train_relational_strata_all();
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--train-sft") == 1.0 || cartan_string_eq(flag, "-train-sft") == 1.0) {
            var target = get_cli_target_path(arg_count);
            if (cartan_string_length(target) == 0.0) { target = "Projects/geomind/trainingdata/sft_manifest.json"; }
            let layers = get_cli_param_float("-layers", arg_count, 42.0);
            let epochs = get_cli_epochs(arg_count, 3.0);
            let lr = get_cli_param_float("-lr", arg_count, 0.02);
            geomind_sft_train_manifest(target, layers, epochs, lr);
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--train-ce") == 1.0 || cartan_string_eq(flag, "-train-ce") == 1.0) {
            var target = get_cli_target_path(arg_count);
            if (cartan_string_length(target) == 0.0) { target = "Projects/geomind/trainingdata/storytelling_chunks/chunk_005_t1_GeoMind_Modern_Narratives.txt"; }
            let layers = get_cli_param_float("-layers", arg_count, 42.0);
            let epochs = get_cli_epochs(arg_count, 3.0);
            let lr = get_cli_param_float("-lr", arg_count, 0.03);
            if (cartan_file_exists(target) == 1.0) {
                geomind_pretrain_ce_corpus(cartan_read_file(target), layers, epochs, lr);
            } else {
                printf("[Error] Pre-training target file '%s' not found.\n", target);
            }
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--train-cloze") == 1.0 || cartan_string_eq(flag, "-train-cloze") == 1.0) {
            var target = get_cli_target_path(arg_count);
            if (cartan_string_length(target) == 0.0) { target = "Projects/geomind/trainingdata/e8_concept_triples.txt"; }
            let layers = get_cli_param_float("-layers", arg_count, 42.0);
            let epochs = get_cli_epochs(arg_count, 3.0);
            let lr = get_cli_param_float("-lr", arg_count, 0.03);
            if (cartan_file_exists(target) == 1.0) {
                geomind_cloze_train_corpus(cartan_read_file(target), layers, epochs, lr);
            } else {
                printf("[Error] Cloze target file '%s' not found.\n", target);
            }
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--streams") == 1.0 || cartan_string_eq(flag, "-streams") == 1.0) {
            geomind_streams_test_all();
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--sleep") == 1.0 || cartan_string_eq(flag, "-sleep") == 1.0) {
            let cycles = get_cli_param_float("-cycles", arg_count, 1.0);
            geomind_sleep_run_full_cycle(cycles);
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--ode-test") == 1.0 || cartan_string_eq(flag, "-ode-test") == 1.0) {
            geomind_ode_test_all();
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--azr") == 1.0 || cartan_string_eq(flag, "-azr") == 1.0) {
            let episodes = get_cli_param_float("-episodes", arg_count, 1.0);
            let lr = get_cli_param_float("-lr", arg_count, 0.01);
            geomind_azr_run_self_play(episodes, lr);
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--webgpu-test") == 1.0 || cartan_string_eq(flag, "-webgpu-test") == 1.0) {
            geomind_webgpu_test_all();
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--merge-test") == 1.0 || cartan_string_eq(flag, "-merge-test") == 1.0) {
            geomind_merge_test_all();
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--ising-test") == 1.0 || cartan_string_eq(flag, "-ising-test") == 1.0) {
            geomind_ising_test_all();
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--log-test") == 1.0 || cartan_string_eq(flag, "-log-test") == 1.0) {
            geomind_log_test_all();
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--byte-latent") == 1.0 || cartan_string_eq(flag, "-byte-latent") == 1.0) {
            let target = get_cli_target_path(arg_count);
            let prompt = get_cli_prompt(arg_count);
            let anchor_word = get_cli_param("-anchor", arg_count);
            let primer_mode = get_cli_flag_present("-primer", arg_count);
            let focus_mode = get_cli_flag_present("-focus", arg_count);
            let epochs = get_cli_epochs(arg_count, 5.0);
            let lr = get_cli_param_float("-lr", arg_count, 0.03);
            let layers = get_cli_param_float("-layers", arg_count, 42.0);
            let vis = get_cli_flag_present("-visualize", arg_count);
            var corpus_text = "In pure mathematics and differential geometry, the exceptional Lie algebra E8 decomposes into the 120-dimensional orthogonal gauge algebra so(16) and the 128-dimensional Majorana-Weyl spinor representation S16+.";
            if (cartan_string_length(target) > 0.0 && cartan_file_exists(target) == 1.0) {
                corpus_text = cartan_read_file(target);
            }
            if (primer_mode == 1.0) {
                geomind_e8_anchors_reset();
                g_e8_primer_crystallize_all = 1.0;
            } else if (cartan_string_length(anchor_word) > 0.0) {
                geomind_e8_anchors_reset();
                geomind_e8_seed_concept_word(anchor_word);
            } else if (focus_mode == 1.0) {
                geomind_e8_anchors_load("Projects/geomind/trainingdata/checkpoints/geomind_e8_anchors.bin");
            }
            geomind_visualizer_reset();
            let final_act = geomind_byte_latent_train_deep_e8_corpus(corpus_text, layers, epochs, lr, vis);
            g_e8_primer_crystallize_all = 0.0;
            var gen_seed = "In pure mathematics";
            if (cartan_string_length(prompt) > 0.0) { gen_seed = prompt; }
            let gen_str = geomind_byte_latent_generate_deep_e8(gen_seed, layers, 64.0);
            printf("[CARTAN-E8 Two-Tier BLT (L=%.0f | Patches=%.0f | Anchors=%.0f | Focus=%.0f | NoiseSkipped=%.0f)] Final Lagrangian Action S = %.6f | Generated: %s\n",
                layers, g_blt_last_patch_count, g_e8_anchor_count, g_e8_focus_hits, g_e8_noise_skips, final_act, gen_str);
            if (vis == 1.0) {
                geomind_visualizer_export_html("manifold_relaxation.html", "Deep E8 Byte-Latent Stack");
                printf("[CARTAN-E8 Visualizer] Exported manifold_relaxation.html\n");
            }
            cartan_flush(0.0);
            return 0.0;
        }

        if (cartan_string_eq(flag, "--crawl") == 1.0 || cartan_string_eq(flag, "-crawl") == 1.0) {
            let url = get_cli_param("-crawl", arg_count);
            let recurse = get_cli_flag_present("-recurse", arg_count);
            let max_depth = get_cli_param_float("-max-depth", arg_count, 1.0);
            let epochs = get_cli_epochs(arg_count, 3.0);
            let vis = get_cli_flag_present("-visualize", arg_count);
            geomind_visualizer_reset();
            geomind_crawl_and_train(url, "", recurse, 0.0, max_depth, epochs, vis);
            cartan_flush(0.0);
            return 0.0;
        }

        i = i + 1.0;
    }

    // Single-turn prompt generation if -prompt is passed
    let single_prompt = get_cli_prompt(arg_count);
    if (cartan_string_length(single_prompt) > 0.0) {
        geomind_wordnet_init_if_needed();
        geomind_e8_sent_basins_load_if_needed();
        geomind_markov_init_if_needed();
        let default_m = "Projects/geomind/trainingdata/checkpoints/geomind_e8_markov_tapestry.bin";
        if (cartan_file_exists(default_m) == 1.0) {
            geomind_markov_load_prior(default_m);
        }
        let reply = geomind_chat_turn(single_prompt);
        printf("GeoMind [E8-248D]> %s\n", reply);
        cartan_flush(0.0);
        return 0.0;
    }

    // Default mode: Interactive continuous 248-D E8 Chat REPL
    return geomind_chat_interactive_loop();
}
